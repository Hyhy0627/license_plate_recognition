# Backend settings; copy to .env and keep real credentials out of Git.
APP_NAME="Automatic License Plate Recognition System"
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
INFERENCE_THREADS=2

# AI paths are relative to the repository root when running locally.
MODEL_RUNTIME=local
YOLO_MODEL_PATH=models/best.pt
OCR_MODEL_PATH=models/LP_ocr.pt
VEHICLE_MODEL_PATH=models/yolov8n.pt
VIDEO_ENGINE=onnx
VIDEO_PLATE_MODEL_PATH=models/video/DetectLisence_YOLO11.pt
VIDEO_OCR_MODEL_PATH=models/video/cct_s_v1_vn.onnx
VIDEO_OCR_CONFIG_PATH=models/video/cct_s_v1_vn_plate_config.yaml
VIDEO_OCR_MIN_CONFIDENCE=0.7
# hybrid | fastplate | yolo | onnx | cct | 9router | paddleocr | easyocr
# fastplate reads image crops with CCT-VN first, then uses LP_ocr.pt for uncertain reads.
# Select yolo for local image recognition without NineRouter.
# Select onnx/cct for the sequence OCR configured by VIDEO_OCR_MODEL/CONFIG_PATH.
OCR_ENGINE=hybrid
CONFIDENCE_THRESHOLD=0.5
# Optional source used by scripts/download_models.py. Set in the shell before installation.
# ALPR_MODEL_SOURCE=s3://your-model-bucket/baseline-v1

# Optional external Vision gateway. Model ID must exist on your gateway.
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=""
NINEROUTER_MODEL=ag/gemini-3.8-flash
NINEROUTER_TIMEOUT=6.0
VIDEO_NINEROUTER_TIMEOUT=10.0

# Runtime storage; never commit database, uploads or recognition outputs.
DATABASE_URL=sqlite:///data/alpr.db
# PostgreSQL example: postgresql://user:password@localhost:5432/alpr
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
STORAGE_BACKEND=local
OUTPUT_DIR=data/outputs
CROPPED_PLATES_DIR=data/outputs/cropped_plates
FINAL_RESULTS_DIR=data/outputs/final_results
# Set STORAGE_BACKEND=s3, create the private bucket, then configure the fields below.
S3_BUCKET=
S3_REGION=us-east-1
# Set the endpoint for MinIO, e.g. https://minio.example.com:9000. Leave blank for AWS S3.
S3_ENDPOINT_URL=
# Leave these blank to use the AWS SDK credential chain.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
