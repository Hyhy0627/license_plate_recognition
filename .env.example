# Environment Variables Example for ALPR System

# App Settings
APP_NAME="ALPR System"
APP_ENV="development"
DEBUG=True
API_HOST="0.0.0.0"
API_PORT=8000

# AI Model Paths
YOLO_MODEL_PATH="models/plate_detection/best.pt"
OCR_ENGINE="paddleocr" # Options: paddleocr | easyocr
CONFIDENCE_THRESHOLD=0.5

# Database Settings (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="alpr_db"

# Storage Settings
UPLOAD_DIR="data/outputs"
STATIC_URL_PREFIX="/static"
