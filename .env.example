# Environment Variables Example for ALPR System

# App Settings
APP_NAME="ALPR System"
APP_ENV="development"
DEBUG=True
API_HOST="0.0.0.0"
API_PORT=8000

# AI Model Paths
YOLO_MODEL_PATH="models/best.pt"
# Options: 9router | paddleocr | easyocr | yolo
OCR_ENGINE="9router"
CONFIDENCE_THRESHOLD=0.5

# 9Router Vision API Settings
NINEROUTER_BASE_URL="http://localhost:20128/v1"
NINEROUTER_API_KEY="sk-61f55deb9d48b9e9-nh78ky-98700cc2"
# Model ID: ví dụ: ag/gemini-2.0-flash, gpt-4o-mini, cl/anthropic/claude-sonnet-4.6, v.v.
NINEROUTER_MODEL="ag/gemini-2.0-flash"
NINEROUTER_TIMEOUT=20.0

# Database Settings
DATABASE_URL="sqlite:///data/alpr.db"

# Storage Settings
OUTPUT_DIR="data/outputs"
STATIC_URL_PREFIX="/static"
